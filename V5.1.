void ResetDailyCounters()
{
   TradeDay =
      TimeDayOfYear(
         TimeCurrent()
      );


   DayStartBalance =
      AccountBalance();


   TradesToday = 0;
}


void UpdateDailyCounters()
{
   int today =
      TimeDayOfYear(
         TimeCurrent()
      );


   if(today != TradeDay)
      ResetDailyCounters();
}


