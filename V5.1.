// ENTRY READY
//==================================================================

bool EntryReady()
{
   if(PositionExists())
      return(false);


   if(!DailyRiskOK())
      return(false);


   if(
      MaxTradesPerDay > 0 &&
      TradesToday >= MaxTradesPerDay
   )
      return(false);


   // Strict T100 sequence:
   // H4 -> H1 -> M15 -> M5 -> M1 pullback -> M1 EMA cross.
   if(IsM1Bull)
   {
      if(!MarketBullish())
         return(false);

      if(!BullPullbackArmed())
         return(false);

      if(!BullCross())
         return(false);

      if(EntryScore < MinimumTradeScore)
         return(false);

      return(true);
   }


   if(IsM1Bear)
   {
      if(!MarketBearish())
         return(false);

      if(!BearPullbackArmed())
         return(false);

      if(!BearCross())
         return(false);

      if(EntryScore > -MinimumTradeScore)
         return(false);

      return(true);
   }


   return(false);
}


//==================================================================
// POSITION EXISTS
//==================================================================

bool PositionExists()
{
   for(
      int i = OrdersTotal()-1;
      i >= 0;
      i--
   )
   {
      if(
         !OrderSelect(
            i,
            SELECT_BY_POS,
            MODE_TRADES
         )
      )
         continue;


      if(
         OrderSymbol() !=
         Symbol()
      )
         continue;


      if(
         OrderMagicNumber() !=
         MagicNumber
      )
         continue;


      if(
         OrderType() == OP_BUY ||
         OrderType() == OP_SELL
      )
         return(true);
   }


   return(false);
}


//==================================================================
// RISK-BASED LOT SIZE
//==================================================================

double CalculateLot(
   double stopDistancePrice
)
{
   if(RiskPercent <= 0.0)
      return(
         MarketInfo(
            Symbol(),
            MODE_MINLOT
         )
      );


   double riskMoney =
      AccountBalance() *
      RiskPercent /
      100.0;


   double tickValue =
      MarketInfo(
         Symbol(),
         MODE_TICKVALUE
      );


   double tickSize =
      MarketInfo(
         Symbol(),
         MODE_TICKSIZE
      );


   if(
      tickValue <= 0 ||
      tickSize <= 0 ||
      stopDistancePrice <= 0
   )
   {
      return(
         MarketInfo(
            Symbol(),
            MODE_MINLOT
         )
      );
   }


   double lossPerLot =
      (
         stopDistancePrice /
         tickSize
      ) *
      tickValue;


   if(lossPerLot <= 0)
      return(
         MarketInfo(
            Symbol(),
            MODE_MINLOT
         )
      );


   double lots =
      riskMoney /
      lossPerLot;


   double minLot =
      MarketInfo(
         Symbol(),
         MODE_MINLOT
      );


   double maxLot =
      MarketInfo(
         Symbol(),
         MODE_MAXLOT
      );


   double lotStep =
      MarketInfo(
         Symbol(),
         MODE_LOTSTEP
      );


   if(lotStep <= 0)
      lotStep = 0.01;


   lots =
      MathFloor(
         lots / lotStep
      ) *
      lotStep;


   lots =
      MathMax(
         minLot,
         lots
      );


   lots =
      MathMin(
         maxLot,
         lots
      );


   int lotDigits = 2;


   if(lotStep >= 1.0)
      lotDigits = 0;

   else
   if(lotStep >= 0.1)
      lotDigits = 1;


   return(
      NormalizeDouble(
         lots,
         lotDigits
      )
   );
}


//==================================================================
// FIX 5 - OPEN TRADE
//==================================================================

void OpenTrade()
{
   if(PositionExists())
   {
      if(DebugMode)
         Print(
            "OpenTrade blocked: position already exists"
         );

      return;
   }


   RefreshRates();


   double atr =
      iATR(
         Symbol(),
         PERIOD_M1,
         ATRPeriod,
         1
      );


   if(atr <= 0)
      atr = ATR_M15;


   if(atr <= 0)
   {
      Print(
         "OpenTrade failed: ATR unavailable"
      );

      return;
   }


   double slDistance =
      MathMax(
         atr * ATR_SL_Multiplier,
         MinimumSLPoints * Point
      );


   double tpDistance =
      MathMax(
         atr * ATR_TP_Multiplier,
         MinimumTPPoints * Point
      );


   int stopLevel =
      (int)MarketInfo(
         Symbol(),
         MODE_STOPLEVEL
      );


   double minStop =
      (stopLevel + 2) * Point;


   slDistance =
      MathMax(
         slDistance,
         minStop
      );


   tpDistance =
      MathMax(
         tpDistance,
         minStop
      );


   double lots =
      CalculateLot(
         slDistance
      );


   if(lots <= 0)
   {
      Print(
         "OpenTrade failed: calculated lots <= 0"
      );

      return;
   }


   int ticket = -1;

   int type = -1;

   double price = 0;
   double sl = 0;
   double tp = 0;


   if(IsM1Bull)
   {
      type = OP_BUY;

      price = Ask;

      sl =
         NormalizeDouble(
            price - slDistance,
            Digits
         );

      tp =
         NormalizeDouble(
            price + tpDistance,
            Digits
         );
   }

   else
   if(IsM1Bear)
   {
      type = OP_SELL;

      price = Bid;

      sl =
         NormalizeDouble(
            price + slDistance,
            Digits
         );

      tp =
         NormalizeDouble(
            price - tpDistance,
            Digits
         );
   }

   else
   {
      return;
   }


   string commentText =
      "T100 Trend Rider v5";


   ResetLastError();


   ticket =
      OrderSend(
         Symbol(),
         type,
         lots,
         price,
         10,
         sl,
         tp,
         commentText,
         MagicNumber,
         0,
         (type == OP_BUY ?
          clrBlue :
          clrRed)
      );


   if(ticket < 0)
   {
      int err =
         GetLastError();


      Print(
         "ORDER SEND FAILED. Error=",
         err,
         " type=",
         type,
         " lots=",
         DoubleToString(lots,2),
         " price=",
         DoubleToString(price,Digits),
         " SL=",
         DoubleToString(sl,Digits),
         " TP=",
         DoubleToString(tp,Digits)
      );


      return;
   }


   TradesToday++;


   Print(
      "===================================================="
   );


   Print(
      "TRADE OPENED v5.10 ticket=",
      ticket,
      " direction=",
      (
         type == OP_BUY ?
         "BUY" :
         "SELL"
      ),
      " lots=",
      DoubleToString(lots,2),
      " score=",
      DoubleToString(EntryScore,0),
      " ATR=",
      DoubleToString(atr,Digits)
   );


   Print(
      "SL=",
      DoubleToString(sl,Digits),
      " TP=",
      DoubleToString(tp,Digits)
   );


   Print(
      "===================================================="
   );
}


//==================================================================
// FIX 6 - TRADE MANAGEMENT
//==================================================================

void ManageOpenTrades()
{
   RefreshRates();


   double atr =
      iATR(
         Symbol(),
         PERIOD_M1,
         ATRPeriod,
         0
      );


   if(atr <= 0)
   {
      atr =
         iATR(
            Symbol(),
            PERIOD_M15,
            ATRPeriod,
            1
         );
   }


   if(atr <= 0)
      return;


   for(
      int i = OrdersTotal()-1;
      i >= 0;
      i--
   )
   {
      if(
         !OrderSelect(
            i,
            SELECT_BY_POS,
            MODE_TRADES
         )
      )
         continue;


      if(
         OrderSymbol() !=
         Symbol()
      )
         continue;


      if(
         OrderMagicNumber() !=
         MagicNumber
      )
         continue;


      if(
         OrderType() != OP_BUY &&
         OrderType() != OP_SELL
      )
         continue;


      double openPrice =
         OrderOpenPrice();


      double currentSL =
         OrderStopLoss();


      double newSL =
         currentSL;


      bool modify = false;


      //============================================================
      // BUY
      //============================================================

      if(OrderType() == OP_BUY)
      {
         double profitDistance =
            Bid - openPrice;


         // Break-even.
         if(
            UseBreakEven &&
            profitDistance >=
            atr * BreakEvenATR
         )
         {
            double be =
               openPrice +
               BreakEvenPlusPoints * Point;


            if(
               currentSL < be
            )
            {
               newSL = be;
               modify = true;
            }
         }


         // ATR trailing.
         if(
            UseTrailingStop &&
            profitDistance >
            atr * TrailingATR
         )
         {
            double trail =
               Bid -
               atr * TrailingATR;


            if(
               trail > newSL &&
               trail > openPrice
            )
            {
               newSL = trail;
               modify = true;
            }
         }


         double maxAllowed =
            Bid -
            (
               MarketInfo(
                  Symbol(),
                  MODE_STOPLEVEL
               ) + 2
            ) * Point;


         if(newSL > maxAllowed)
            newSL = maxAllowed;


         if(
            modify &&
            newSL > currentSL &&
            newSL < Bid
         )
         {
            newSL =
               NormalizeDouble(
                  newSL,
                  Digits
               );


            ResetLastError();


            if(
               !OrderModify(
                  OrderTicket(),
                  OrderOpenPrice(),
                  newSL,
                  OrderTakeProfit(),
                  0,
                  clrNONE
               )
            )
            {
               Print(
                  "BUY OrderModify failed ticket=",
                  OrderTicket(),
                  " error=",
                  GetLastError()
               );
            }
         }
      }


      //============================================================
      // SELL
      //============================================================

      else
      if(OrderType() == OP_SELL)
      {
         double profitDistance =
            openPrice - Ask;


         // Break-even.
         if(
            UseBreakEven &&
            profitDistance >=
            atr * BreakEvenATR
         )
         {
            double be =
               openPrice -
               BreakEvenPlusPoints * Point;


            if(
               currentSL == 0 ||
               currentSL > be
            )
            {
               newSL = be;
               modify = true;
            }
         }


         // ATR trailing.
         if(
            UseTrailingStop &&
            profitDistance >
            atr * TrailingATR
         )
         {
            double trail =
               Ask +
               atr * TrailingATR;


            if(
               (
                  newSL == 0 ||
                  trail < newSL
               ) &&
               trail < openPrice
            )
            {
               newSL = trail;
               modify = true;
            }
         }


         double minAllowed =
            Ask +
            (
               MarketInfo(
                  Symbol(),
                  MODE_STOPLEVEL
               ) + 2
            ) * Point;


         if(
            newSL < minAllowed &&
            newSL > 0
         )
         {
            newSL = minAllowed;
         }


         if(
            modify &&
            (
               currentSL == 0 ||
               newSL < currentSL
            ) &&
            newSL > Ask
         )
         {
            newSL =
               NormalizeDouble(
                  newSL,
                  Digits
               );


            ResetLastError();


            if(
               !OrderModify(
                  OrderTicket(),
                  OrderOpenPrice(),
                  newSL,
                  OrderTakeProfit(),
                  0,
                  clrNONE
               )
            )
            {
               Print(
                  "SELL OrderModify failed ticket=",
                  OrderTicket(),
                  " error=",
                  GetLastError()
               );
            }
         }
      }
   }
}


