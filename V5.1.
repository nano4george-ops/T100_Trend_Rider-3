#property strict
#property version "5.10"
#property description "T100 Trend Rider v5.10 - H4 primary trend, pullback then M1 EMA cross"

//==================================================================
// INPUTS
//==================================================================

input int      FastEMA              = 20;
input int      SlowEMA              = 50;

input int      RSIPeriod            = 14;
input double   BullRSI              = 55.0;
input double   BearRSI              = 45.0;

input int      ATRPeriod            = 14;
input double   MinATRPoints         = 0.0;      // 0 = disabled

input int      ADXPeriod            = 14;
input double   MinADX               = 20.0;

input long     MinVolume            = 100;
input int      MaxSpread            = 50;

// Trading-hours filter.
// OFF by default so Strategy Tester can test all historical data.
input bool     UseTradingHours      = false;
input int      TradingStartHour     = 8;
input int      TradingEndHour       = 18;

// Entry scoring
input int      MinimumTradeScore    = 60;
input double   MinEMADistancePoints = 2.0;
input double   PullbackATRMax       = 1.50;
input bool     RequirePullback      = true;

// Pullback must be followed by an M1 EMA20/EMA50 cross.
// A pullback remains valid for this many completed M1 bars.
input int      PullbackMaxBars        = 3;

// Risk / trade limits
input double   RiskPercent          = 1.0;
input double   MaxDailyLossPercent  = 3.0;
input int      MaxTradesPerDay      = 5;
input int      MagicNumber          = 1001;

// Stops
input double   ATR_SL_Multiplier    = 2.0;
input double   ATR_TP_Multiplier    = 3.0;
input int      MinimumSLPoints      = 100;
input int      MinimumTPPoints      = 150;

// Trade management
input bool     UseBreakEven         = true;
input double   BreakEvenATR         = 1.0;
input double   BreakEvenPlusPoints  = 2.0;

input bool     UseTrailingStop      = true;
input double   TrailingATR          = 1.5;

input bool     DebugMode            = true;


//==================================================================
// GLOBALS
//==================================================================

datetime LastBar = 0;

int      TradeDay = -1;
int      TradesToday = 0;

double   DayStartBalance = 0.0;

bool IndicatorsReady = false;
bool TradingHoursOK  = true;
bool SpreadOK        = false;


//------------------------------------------------------------------
// Cached indicators
//------------------------------------------------------------------

double EMA20_H4  = 0;
double EMA50_H4  = 0;

double EMA20_H1  = 0;
double EMA50_H1  = 0;

double EMA20_M15 = 0;
double EMA50_M15 = 0;

double EMA20_M5  = 0;
double EMA50_M5  = 0;

double EMA20_M1  = 0;
double EMA50_M1  = 0;

double RSI_M15   = 0;
double ATR_M15   = 0;
double ADX_M15   = 0;

double CurrentSpread = 0;

long Volume_M15 = 0;


//------------------------------------------------------------------
// Direction / scoring
//------------------------------------------------------------------

double TrendScore = 0;
double EntryScore = 0;

bool IsH4Bull  = false;
bool IsH4Bear  = false;

bool IsH1Bull  = false;
bool IsH1Bear  = false;

bool IsM15Bull = false;
bool IsM15Bear = false;

bool IsM5Bull  = false;
bool IsM5Bear  = false;

bool IsM1Bull  = false;
bool IsM1Bear  = false;

// Pullback -> EMA cross state.
// 0 = not armed, 1..PullbackMaxBars = valid pullback age.
int BullPullbackAge = 0;
int BearPullbackAge = 0;


//==================================================================
// INITIALIZATION
//==================================================================

int OnInit()
{
   LastBar = 0;

   BullPullbackAge = 0;
   BearPullbackAge = 0;

   ResetDailyCounters();

   Print("====================================================");
   Print("T100 Trend Rider v5.10 STARTED");
   Print("Symbol: ", Symbol(), "  Period: ", Period());
   Print("Trading hours filter: ", UseTradingHours);
   Print("Minimum trade score: ", MinimumTradeScore);
   Print("Risk: ", DoubleToString(RiskPercent,2), "%");
   Print("====================================================");

   return(INIT_SUCCEEDED);
}


//==================================================================
// DEINITIALIZATION
//==================================================================

void OnDeinit(const int reason)
{
   Comment("");

   Print("T100 Trend Rider v5.10 stopped.");
}


//==================================================================
// MAIN LOOP
//==================================================================

void OnTick()
{
   // Always manage an existing trade.
   ManageOpenTrades();

   // Entry calculations only happen once per new M1 bar.
   if(!IsNewBar())
      return;

   UpdateDailyCounters();

   if(Bars < SlowEMA + 10)
   {
      if(DebugMode)
         Print("BLOCKED: not enough M1 bars");

      return;
   }

   UpdateIndicators();

   CheckTradingHours();

   CheckSpread();

   if(DebugMode)
      PrintStatus();

   if(!MarketReady())
      return;

   CalculateTrend();

   UpdatePullbackState();

   CalculateEntryScore();

   if(DebugMode)
   {
      Print(
         "TrendScore=",
         DoubleToString(TrendScore,0),
         " EntryScore=",
         DoubleToString(EntryScore,0),
         " M1Bull=",
         IsM1Bull,
         " M1Bear=",
         IsM1Bear
      );
   }

   if(EntryReady())
   {
      OpenTrade();
   }
   else
   {
      if(DebugMode)
         Print("ENTRY NOT READY");
   }
}


//==================================================================
// NEW BAR
//==================================================================

bool IsNewBar()
{
   datetime barTime = iTime(Symbol(), PERIOD_M1, 0);

   if(barTime <= 0)
      return(false);

   if(barTime != LastBar)
   {
      LastBar = barTime;
      return(true);
   }

   return(false);
}


//==================================================================
// UPDATE INDICATORS
//==================================================================

void UpdateIndicators()
{
   // Make sure every timeframe has enough history before accepting
   // indicator values as valid.
   IndicatorsReady =
      (
         iBars(Symbol(), PERIOD_H4)  >= SlowEMA + 10 &&
         iBars(Symbol(), PERIOD_H1)  >= SlowEMA + 10 &&
         iBars(Symbol(), PERIOD_M15) >= SlowEMA + 10 &&
         iBars(Symbol(), PERIOD_M5)  >= SlowEMA + 10 &&
         iBars(Symbol(), PERIOD_M1)  >= SlowEMA + 10
      );

   if(!IndicatorsReady)
      return;

   EMA20_H4 =
      iMA(Symbol(), PERIOD_H4, FastEMA, 0,
          MODE_EMA, PRICE_CLOSE, 1);

   EMA50_H4 =
      iMA(Symbol(), PERIOD_H4, SlowEMA, 0,
          MODE_EMA, PRICE_CLOSE, 1);


   EMA20_H1 =
      iMA(Symbol(), PERIOD_H1, FastEMA, 0,
          MODE_EMA, PRICE_CLOSE, 1);

   EMA50_H1 =
      iMA(Symbol(), PERIOD_H1, SlowEMA, 0,
          MODE_EMA, PRICE_CLOSE, 1);


   EMA20_M15 =
      iMA(Symbol(), PERIOD_M15, FastEMA, 0,
          MODE_EMA, PRICE_CLOSE, 1);

   EMA50_M15 =
      iMA(Symbol(), PERIOD_M15, SlowEMA, 0,
          MODE_EMA, PRICE_CLOSE, 1);


   EMA20_M5 =
      iMA(Symbol(), PERIOD_M5, FastEMA, 0,
          MODE_EMA, PRICE_CLOSE, 1);

   EMA50_M5 =
      iMA(Symbol(), PERIOD_M5, SlowEMA, 0,
          MODE_EMA, PRICE_CLOSE, 1);


   EMA20_M1 =
      iMA(Symbol(), PERIOD_M1, FastEMA, 0,
          MODE_EMA, PRICE_CLOSE, 1);

   EMA50_M1 =
      iMA(Symbol(), PERIOD_M1, SlowEMA, 0,
          MODE_EMA, PRICE_CLOSE, 1);


   RSI_M15 =
      iRSI(Symbol(), PERIOD_M15,
           RSIPeriod, PRICE_CLOSE, 1);


   ATR_M15 =
      iATR(Symbol(), PERIOD_M15,
           ATRPeriod, 1);


   ADX_M15 =
      iADX(Symbol(), PERIOD_M15,
           ADXPeriod,
           PRICE_CLOSE,
           MODE_MAIN,
           1);


   Volume_M15 =
      iVolume(Symbol(), PERIOD_M15, 1);


   CurrentSpread =
      MarketInfo(Symbol(), MODE_SPREAD);


   IndicatorsReady = true;


   if(
      EMA20_H4 <= 0 ||
      EMA50_H4 <= 0 ||

      EMA20_H1 <= 0 ||
      EMA50_H1 <= 0 ||

      EMA20_M15 <= 0 ||
      EMA50_M15 <= 0 ||

      EMA20_M5 <= 0 ||
      EMA50_M5 <= 0 ||

      EMA20_M1 <= 0 ||
      EMA50_M1 <= 0 ||

      RSI_M15 <= 0 ||
      ATR_M15 <= 0 ||
      ADX_M15 <= 0 ||

      Volume_M15 <= 0
   )
   {
      IndicatorsReady = false;
   }
}


//==================================================================
// TRADING HOURS
//==================================================================

void CheckTradingHours()
{
   // Disabled = always allowed.
   if(!UseTradingHours)
   {
      TradingHoursOK = true;
      return;
   }


   int h = TimeHour(TimeCurrent());


   // Same start/end = 24 hours.
   if(TradingStartHour == TradingEndHour)
   {
      TradingHoursOK = true;
      return;
   }


   // Normal session, e.g. 08 -> 18.
   if(TradingStartHour < TradingEndHour)
   {
      TradingHoursOK =
         (h >= TradingStartHour &&
          h < TradingEndHour);

      return;
   }


   // Overnight session, e.g. 22 -> 06.
   TradingHoursOK =
      (h >= TradingStartHour ||
       h < TradingEndHour);
}


//==================================================================
// SPREAD
//==================================================================

void CheckSpread()
{
   CurrentSpread =
      MarketInfo(Symbol(), MODE_SPREAD);

   SpreadOK =
      (
         CurrentSpread >= 0 &&
         CurrentSpread <= MaxSpread
      );
}


//==================================================================
// ATR FILTER
//==================================================================

bool ATR_OK()
{
   // 0 disables ATR minimum filter.
   if(MinATRPoints <= 0.0)
      return(true);

   double atrPoints =
      ATR_M15 / Point;

   return(atrPoints >= MinATRPoints);
}


//==================================================================
// VOLUME FILTER
//==================================================================

bool Volume_OK()
{
   if(MinVolume <= 0)
      return(true);

   return(Volume_M15 >= MinVolume);
}


//==================================================================
// ADX FILTER
//==================================================================

bool ADX_OK()
{
   if(MinADX <= 0.0)
      return(true);

   return(ADX_M15 >= MinADX);
}


//==================================================================
// DAILY RISK
//==================================================================

bool DailyRiskOK()
{
   if(MaxDailyLossPercent <= 0.0)
      return(true);

   if(DayStartBalance <= 0.0)
      return(true);


   double equityLoss =
      DayStartBalance - AccountEquity();


   double lossPercent =
      100.0 *
      equityLoss /
      DayStartBalance;


   return(lossPercent < MaxDailyLossPercent);
}


//==================================================================
// MARKET READY
//==================================================================

bool MarketReady()
{
   if(!IndicatorsReady)
   {
      if(DebugMode)
         Print("BLOCKED: IndicatorsReady = FALSE");

      return(false);
   }


   if(!TradingHoursOK)
   {
      if(DebugMode)
         Print("BLOCKED: TradingHoursOK = FALSE");

      return(false);
   }


   if(!SpreadOK)
   {
      if(DebugMode)
      {
         Print(
            "BLOCKED: SpreadOK = FALSE, spread=",
            CurrentSpread,
            " max=",
            MaxSpread
         );
      }

      return(false);
   }


   if(!ATR_OK())
   {
      if(DebugMode)
      {
         Print(
            "BLOCKED: ATR filter, ATR points=",
            DoubleToString(ATR_M15 / Point,1)
         );
      }

      return(false);
   }


   if(!Volume_OK())
   {
      if(DebugMode)
         Print(
            "BLOCKED: Volume filter, volume=",
            Volume_M15
         );

      return(false);
   }


   if(!ADX_OK())
   {
      if(DebugMode)
         Print(
            "BLOCKED: ADX filter, ADX=",
            DoubleToString(ADX_M15,2)
         );

      return(false);
   }


   if(!DailyRiskOK())
   {
      if(DebugMode)
         Print("BLOCKED: daily loss limit reached");

      return(false);
   }


   if(
      TradesToday >= MaxTradesPerDay &&
      MaxTradesPerDay > 0
   )
   {
      if(DebugMode)
         Print(
            "BLOCKED: MaxTradesPerDay reached: ",
            TradesToday,
            "/",
            MaxTradesPerDay
         );

      return(false);
   }


   return(true);
}


//==================================================================
// TREND CALCULATION
//==================================================================

void CalculateTrend()
{
   IsH4Bull =
      EMA20_H4 > EMA50_H4;

   IsH4Bear =
      EMA20_H4 < EMA50_H4;


   IsH1Bull =
      EMA20_H1 > EMA50_H1;

   IsH1Bear =
      EMA20_H1 < EMA50_H1;


   IsM15Bull =
      EMA20_M15 > EMA50_M15;

   IsM15Bear =
      EMA20_M15 < EMA50_M15;


   IsM5Bull =
      EMA20_M5 > EMA50_M5;

   IsM5Bear =
      EMA20_M5 < EMA50_M5;


   TrendScore = 0;


   // H4 = 30 points.
   if(IsH4Bull)
      TrendScore += 30;

   if(IsH4Bear)
      TrendScore -= 30;


   // H1 = 25 points.
   if(IsH1Bull)
      TrendScore += 25;

   if(IsH1Bear)
      TrendScore -= 25;


   // M15 = 20 points.
   if(IsM15Bull)
      TrendScore += 20;

   if(IsM15Bear)
      TrendScore -= 20;


   // M5 = 15 points.
   if(IsM5Bull)
      TrendScore += 15;

   if(IsM5Bear)
      TrendScore -= 15;
}


//==================================================================
// MARKET DIRECTION
//==================================================================

bool MarketBullish()
{
   // H4 is the PRIMARY trend. All lower timeframes must agree.
   return(
      IsH4Bull &&
      IsH1Bull &&
      IsM15Bull &&
      IsM5Bull
   );
}

bool MarketBearish()
{
   // H4 is the PRIMARY trend. All lower timeframes must agree.
   return(
      IsH4Bear &&
      IsH1Bear &&
      IsM15Bear &&
      IsM5Bear
   );
}


//==================================================================
// M1 CROSS
//==================================================================

bool BullCross()
{
   double fastPrev =
      iMA(
         Symbol(),
         PERIOD_M1,
         FastEMA,
         0,
         MODE_EMA,
         PRICE_CLOSE,
         2
      );


   double slowPrev =
      iMA(
         Symbol(),
         PERIOD_M1,
         SlowEMA,
         0,
         MODE_EMA,
         PRICE_CLOSE,
         2
      );


   double fastNow =
      iMA(
         Symbol(),
         PERIOD_M1,
         FastEMA,
         0,
         MODE_EMA,
         PRICE_CLOSE,
         1
      );


   double slowNow =
      iMA(
         Symbol(),
         PERIOD_M1,
         SlowEMA,
         0,
         MODE_EMA,
         PRICE_CLOSE,
         1
      );


   return(
      fastPrev <= slowPrev &&
      fastNow > slowNow
   );
}


//==================================================================
// M1 BEAR CROSS
//==================================================================

bool BearCross()
{
   double fastPrev =
      iMA(
         Symbol(),
         PERIOD_M1,
         FastEMA,
         0,
         MODE_EMA,
         PRICE_CLOSE,
         2
      );


   double slowPrev =
      iMA(
         Symbol(),
         PERIOD_M1,
         SlowEMA,
         0,
         MODE_EMA,
         PRICE_CLOSE,
         2
      );


   double fastNow =
      iMA(
         Symbol(),
         PERIOD_M1,
         FastEMA,
         0,
         MODE_EMA,
         PRICE_CLOSE,
         1
      );


   double slowNow =
      iMA(
         Symbol(),
         PERIOD_M1,
         SlowEMA,
         0,
         MODE_EMA,
         PRICE_CLOSE,
         1
      );


   return(
      fastPrev >= slowPrev &&
      fastNow < slowNow
   );
}


//==================================================================
// FIX 1 - BULL PULLBACK
//==================================================================

bool BullPullback()
{
   if(!MarketBullish())
      return(false);


   double ema =
      EMA20_M1;


   double atr =
      iATR(
         Symbol(),
         PERIOD_M1,
         ATRPeriod,
         1
      );


   if(atr <= 0)
      return(false);


   double close1 =
      iClose(Symbol(), PERIOD_M1, 1);


   double low1 =
      iLow(Symbol(), PERIOD_M1, 1);


   bool touched =
      (low1 <= ema);


   bool closedAbove =
      (close1 > ema);


   bool reasonableDistance =
      (
         MathAbs(close1 - ema) <=
         atr * PullbackATRMax
      );


   return(
      touched &&
      closedAbove &&
      reasonableDistance
   );
}


//==================================================================
// FIX 1 - BEAR PULLBACK
//==================================================================

bool BearPullback()
{
   if(!MarketBearish())
      return(false);


   double ema =
      EMA20_M1;


   double atr =
      iATR(
         Symbol(),
         PERIOD_M1,
         ATRPeriod,
         1
      );


   if(atr <= 0)
      return(false);


   double close1 =
      iClose(Symbol(), PERIOD_M1, 1);


   double high1 =
      iHigh(Symbol(), PERIOD_M1, 1);


   bool touched =
      (high1 >= ema);


   bool closedBelow =
      (close1 < ema);


   bool reasonableDistance =
      (
         MathAbs(close1 - ema) <=
         atr * PullbackATRMax
      );


   return(
      touched &&
      closedBelow &&
      reasonableDistance
   );
}


//==================================================================
// PULLBACK STATE
//==================================================================
//
// Strategy sequence:
// H4 primary trend
// -> H1 confirmation
// -> M15 confirmation
// -> M5 confirmation
// -> M1 pullback
// -> M1 EMA20/EMA50 cross
//
// The pullback is "armed" first and remains valid for a limited
// number of completed M1 bars. The EMA cross then becomes mandatory.
//==================================================================

void UpdatePullbackState()
{
   // Pullback states are only valid while the higher-timeframe
   // market direction remains aligned.
   if(!MarketBullish())
      BullPullbackAge = 0;

   if(!MarketBearish())
      BearPullbackAge = 0;


   // Detect a fresh pullback on the current closed M1 bar.
   if(MarketBullish() && BullPullback())
   {
      BullPullbackAge = 1;
      BearPullbackAge = 0;

      if(DebugMode)
         Print("PULLBACK ARMED: BUY, age=1");
   }
   else
   if(BullPullbackAge > 0)
   {
      BullPullbackAge++;

      if(
         PullbackMaxBars <= 0 ||
         BullPullbackAge > PullbackMaxBars
      )
      {
         BullPullbackAge = 0;

         if(DebugMode)
            Print("PULLBACK EXPIRED: BUY");
      }
   }


   if(MarketBearish() && BearPullback())
   {
      BearPullbackAge = 1;
      BullPullbackAge = 0;

      if(DebugMode)
         Print("PULLBACK ARMED: SELL, age=1");
   }
   else
   if(BearPullbackAge > 0)
   {
      BearPullbackAge++;

      if(
         PullbackMaxBars <= 0 ||
         BearPullbackAge > PullbackMaxBars
      )
      {
         BearPullbackAge = 0;

         if(DebugMode)
            Print("PULLBACK EXPIRED: SELL");
      }
   }
}


bool BullPullbackArmed()
{
   return(
      MarketBullish() &&
      BullPullbackAge > 0 &&
      (
         PullbackMaxBars <= 0 ||
         BullPullbackAge <= PullbackMaxBars
      )
   );
}


bool BearPullbackArmed()
{
   return(
      MarketBearish() &&
      BearPullbackAge > 0 &&
      (
         PullbackMaxBars <= 0 ||
         BearPullbackAge <= PullbackMaxBars
      )
   );
}


//==================================================================
// MOMENTUM
//==================================================================

bool BullMomentum()
{
   double close1 =
      iClose(Symbol(), PERIOD_M1, 1);

   double close2 =
      iClose(Symbol(), PERIOD_M1, 2);


   return(
      close1 > close2 &&
      close1 > EMA20_M1
   );
}


bool BearMomentum()
{
   double close1 =
      iClose(Symbol(), PERIOD_M1, 1);

   double close2 =
      iClose(Symbol(), PERIOD_M1, 2);


   return(
      close1 < close2 &&
      close1 < EMA20_M1
   );
}


//==================================================================
// FIX 2 - SIMPLE CANDLE FILTER
//==================================================================

bool BullCandleOK()
{
   double o =
      iOpen(Symbol(), PERIOD_M1, 1);

   double c =
      iClose(Symbol(), PERIOD_M1, 1);

   double previousClose =
      iClose(Symbol(), PERIOD_M1, 2);


   return(
      c > o ||
      c > previousClose
   );
}


bool BearCandleOK()
{
   double o =
      iOpen(Symbol(), PERIOD_M1, 1);

   double c =
      iClose(Symbol(), PERIOD_M1, 1);

   double previousClose =
      iClose(Symbol(), PERIOD_M1, 2);


   return(
      c < o ||
      c < previousClose
   );
}


//==================================================================
// FIX 3 - EMA DISTANCE
//==================================================================

bool EMADistanceOK()
{
   double distancePoints =
      MathAbs(
         EMA20_M15 -
         EMA50_M15
      ) / Point;


   return(
      distancePoints >=
      MinEMADistancePoints
   );
}


//==================================================================
// RSI
//==================================================================

bool RSIBullOK()
{
   return(
      RSI_M15 >= BullRSI
   );
}


bool RSIBearOK()
{
   return(
      RSI_M15 <= BearRSI
   );
}


//==================================================================
// ENTRY SCORE
//==================================================================

void CalculateEntryScore()
{
   EntryScore = 0;

   IsM1Bull = false;
   IsM1Bear = false;


   bool bull =
      MarketBullish();

   bool bear =
      MarketBearish();


   bool bullArmed =
      BullPullbackArmed();

   bool bearArmed =
      BearPullbackArmed();


   bool bullCross =
      BullCross();

   bool bearCross =
      BearCross();


   //===============================================================
   // HIGHER-TIMEFRAME TREND
   //===============================================================

   // Because MarketBullish/MarketBearish now requires H4 + H1 +
   // M15 + M5 agreement, this is the first hard direction filter.
   if(bull)
      EntryScore += 30;

   if(bear)
      EntryScore -= 30;


   //===============================================================
   // M15 CONFIRMATION
   //===============================================================

   if(bull && RSIBullOK())
      EntryScore += 15;

   if(bear && RSIBearOK())
      EntryScore -= 15;


   if(ADX_OK())
   {
      if(bull)
         EntryScore += 10;

      if(bear)
         EntryScore -= 10;
   }


   if(EMADistanceOK())
   {
      if(bull)
         EntryScore += 10;

      if(bear)
         EntryScore -= 10;
   }


   //===============================================================
   // M1 PULLBACK
   //===============================================================

   // A pullback is now a required stage in the sequence.
   if(bullArmed)
      EntryScore += 20;

   if(bearArmed)
      EntryScore -= 20;


   //===============================================================
   // M1 EMA CROSS
   //===============================================================

   // The EMA20/EMA50 cross is MANDATORY.
   // It is no longer optional scoring confirmation.
   if(bullCross)
      EntryScore += 10;

   if(bearCross)
      EntryScore -= 10;


   //===============================================================
   // M1 MOMENTUM
   //===============================================================

   if(bull && BullMomentum())
      EntryScore += 8;

   if(bear && BearMomentum())
      EntryScore -= 8;


   //===============================================================
   // M1 CANDLE
   //===============================================================

   if(bull && BullCandleOK())
      EntryScore += 7;

   if(bear && BearCandleOK())
      EntryScore -= 7;


   //===============================================================
   // FINAL ENTRY DIRECTION
   //===============================================================

   // Strict sequence:
   // H4/H1/M15/M5 alignment
   // + pullback armed
   // + M1 EMA cross
   // + score threshold
   IsM1Bull =
      (
         bull &&
         bullArmed &&
         bullCross &&
         EntryScore >= MinimumTradeScore
      );


   IsM1Bear =
      (
         bear &&
         bearArmed &&
         bearCross &&
         EntryScore <= -MinimumTradeScore
      );


   // RequirePullback is retained as an input for backwards
   // compatibility, but strict T100 v5.10 always requires the
   // pullback stage.
}


